{
    "preset": "laravel",
    "rules": {
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "single_quote": true,
        "trailing_comma_in_multiline": true,
        "array_syntax": {
            "syntax": "short"
        },
        "phpdoc_align": {
            "align": "left"
        },
        "phpdoc_separation": true,
        "no_extra_blank_lines": {
            "tokens": ["extra", "throw", "use"]
        }
    }
}
