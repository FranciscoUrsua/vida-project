{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "filament/filament": "^5.3",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "livewire/livewire": "^4.2",
        "nwidart/laravel-modules": "^12.0",
        "simshaun/recurr": "^5.0",
        "spatie/laravel-medialibrary": "^11.21",
        "spatie/laravel-permission": "^7.2",
        "spatie/period": "^2.4",
        "staudenmeir/laravel-adjacency-list": "^1.25",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.5",
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "nunomaduro/larastan": "^3.10",
        "phpunit/phpunit": "^11.5.50",
        "rector/rector": "^2.4"
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Modules\\Organizacion\\": "Modules/Organizacion/app/",
            "Modules\\Organizacion\\Database\\": "Modules/Organizacion/database/",
            "Modules\\Organizacion\\Database\\Seeders\\": "Modules/Organizacion/database/seeders/",
            "Modules\\Organizacion\\Database\\Migrations\\": "Modules/Organizacion/database/migrations/",
            "Modules\\Organizacion\\Database\\Factories\\": "Modules/Organizacion/database/factories/",
            "Modules\\Usuarios\\": "Modules/Usuarios/app/",
            "Modules\\Usuarios\\Database\\": "Modules/Usuarios/database/",
            "Modules\\Usuarios\\Database\\Seeders\\": "Modules/Usuarios/database/seeders/",
            "Modules\\Usuarios\\Database\\Migrations\\": "Modules/Usuarios/database/migrations/",
            "Modules\\Usuarios\\Database\\Factories\\": "Modules/Usuarios/database/factories/",
            "Modules\\Centro\\": "Modules/Centro/app/",
            "Modules\\Centro\\Database\\": "Modules/Centro/database/",
            "Modules\\Centro\\Database\\Seeders\\": "Modules/Centro/database/seeders/",
            "Modules\\Centro\\Database\\Migrations\\": "Modules/Centro/database/migrations/",
            "Modules\\Centro\\Database\\Factories\\": "Modules/Centro/database/factories/",
            "Modules\\Prestaciones\\": "Modules/Prestaciones/app/",
            "Modules\\Prestaciones\\Database\\": "Modules/Prestaciones/database/",
            "Modules\\Prestaciones\\Database\\Seeders\\": "Modules/Prestaciones/database/Seeders/",
            "Modules\\Prestaciones\\Database\\Migrations\\": "Modules/Prestaciones/database/migrations/",
            "Modules\\Prestaciones\\Database\\Factories\\": "Modules/Prestaciones/database/factories/",
            "Modules\\Mensajes\\": "Modules/Mensajes/app/",
            "Modules\\Mensajes\\Database\\": "Modules/Mensajes/database/",
            "Modules\\Mensajes\\Database\\Seeders\\": "Modules/Mensajes/database/seeders/",
            "Modules\\Mensajes\\Database\\Migrations\\": "Modules/Mensajes/database/migrations/",
            "Modules\\Mensajes\\Database\\Factories\\": "Modules/Mensajes/database/factories/",
            "Modules\\Agenda\\": "Modules/Agenda/app/",
            "Modules\\Agenda\\Database\\": "Modules/Agenda/database/",
            "Modules\\Agenda\\Database\\Seeders\\": "Modules/Agenda/database/seeders/",
            "Modules\\Agenda\\Database\\Migrations\\": "Modules/Agenda/database/migrations/",
            "Modules\\Agenda\\Database\\Factories\\": "Modules/Agenda/database/factories/",
            "Modules\\Documentos\\": "Modules/Documentos/app/",
            "Modules\\Documentos\\Database\\": "Modules/Documentos/database/",
            "Modules\\Documentos\\Database\\Seeders\\": "Modules/Documentos/database/seeders/",
            "Modules\\Documentos\\Database\\Migrations\\": "Modules/Documentos/database/migrations/",
            "Modules\\Documentos\\Database\\Factories\\": "Modules/Documentos/database/factories/",
            "Modules\\Intervencion\\": "Modules/Intervencion/app/",
            "Modules\\Intervencion\\Database\\": "Modules/Intervencion/database/",
            "Modules\\Intervencion\\Database\\Seeders\\": "Modules/Intervencion/database/seeders/",
            "Modules\\Intervencion\\Database\\Migrations\\": "Modules/Intervencion/database/migrations/",
            "Modules\\Intervencion\\Database\\Factories\\": "Modules/Intervencion/database/factories/",
            "Modules\\Escalas\\": "Modules/Escalas/app/",
            "Modules\\Escalas\\Database\\": "Modules/Escalas/database/",
            "Modules\\Escalas\\Database\\Seeders\\": "Modules/Escalas/database/seeders/",
            "Modules\\Escalas\\Database\\Migrations\\": "Modules/Escalas/database/migrations/",
            "Modules\\Escalas\\Database\\Factories\\": "Modules/Escalas/database/factories/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Modules\\Usuarios\\Tests\\": "Modules/Usuarios/tests/",
            "Modules\\Mensajes\\Tests\\": "Modules/Mensajes/tests/",
            "Modules\\Documentos\\Tests\\": "Modules/Documentos/tests/",
            "Modules\\Agenda\\Tests\\": "Modules/Agenda/tests/",
            "Modules\\Centro\\Tests\\": "Modules/Centro/tests/",
            "Modules\\Intervencion\\Tests\\": "Modules/Intervencion/tests/",
            "Modules\\Escalas\\Tests\\": "Modules/Escalas/tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "analyse-ci": "vendor/bin/phpstan analyse --memory-limit=512M --no-progress --error-format=github",
        "format": "vendor/bin/pint",
        "format-check": "vendor/bin/pint --test",
        "rector": "vendor/bin/rector process",
        "rector-dry": "vendor/bin/rector process --dry-run",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
