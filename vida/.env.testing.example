# Plantilla de .env.testing (el fichero real no se versiona).
#
# Con APP_ENV=testing (lo fija phpunit.xml), Laravel carga .env.testing en lugar de .env.
# Para crearlo: cp .env.example .env.testing, y en él:
#   APP_ENV=testing
#   APP_KEY=           (php artisan key:generate --env=testing --show, y pegarla aquí)
#   APP_LOCALE=es
#   DB_CONNECTION=pgsql
# y añadir las credenciales del usuario de la BD de test (solo vida_testing*, con CREATEDB
# para la ejecución en paralelo; nunca el usuario de la BD de desarrollo/staging):
DB_USERNAME=vida_test
DB_PASSWORD=
